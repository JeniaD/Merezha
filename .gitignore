# Foundry build output (regenerated by `forge build`)
cache/
out/

# Foundry deployment logs/cache (regenerated; may contain local run metadata)
broadcast/

# Secrets — keep `.env.example` in git as a template
.env
.env.*
!.env.example

# Coverage (from `forge coverage`)
coverage/
lcov.info
.gas-snapshot

# OS noise
.DS_Store

# Python worker local/generated files
worker/venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local notes and submission archives
DEMO.md
*.zip
*.tar
*.tar.gz

# Track these for reproducible builds (do NOT gitignore):
#   lib/          — vendored deps (e.g. forge-std); others run `forge install` if missing
#   foundry.lock  — pins dependency versions (like Cargo.lock)

*.pdf
